{
  "name": "cloudcoder",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "start": "npm run start --workspace server"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.0": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
