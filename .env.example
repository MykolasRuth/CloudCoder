# Copy this file to .env and fill it in. .env is gitignored, so these stay private.
# Anything already set in the environment (e.g. by a LaunchAgent) wins over .env.

# PIN for the web app. Leave empty for no PIN (only on a private tailnet).
CLOUDCODER_PIN=change-me

# Tailscale logins allowed in through `tailscale serve`, comma-separated.
# Left unset, anyone on your tailnet gets in. Example:
# CLOUDCODER_ALLOWED_LOGINS=you@github

# Contact sent to push services along with notifications.
CLOUDCODER_PUSH_CONTACT=mailto:you@example.com

# Optional (these are the defaults):
# CLOUDCODER_PORT=4060
# CLOUDCODER_HOST=127.0.0.1
# CLOUDCODER_PROJECTS=~/Projects
# CLOUDCODER_CLAUDE=/opt/homebrew/bin/claude
